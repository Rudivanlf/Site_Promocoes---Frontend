# Backend API URL
VITE_BASE_API_URL=http://127.0.0.1:8000

# Auth endpoints
VITE_AUTH_REGISTER_PATH=/api/usuarios/
VITE_AUTH_LOGIN_PATH=/api/usuarios/login/
VITE_AUTH_REGISTER_PATHS=/api/usuarios/,/api/usuarios/cadastro/,/api/usuarios/register/
VITE_AUTH_LOGIN_PATHS=/api/usuarios/login/,/api/login/,/api/token/
VITE_AUTH_REGISTER_METHODS=POST
VITE_AUTH_LOGIN_METHODS=POST
VITE_AUTH_EMAIL_FIELD=email
VITE_AUTH_PASSWORD_FIELD=password

# Favorites endpoint - hardcoded in favoritesApi.ts as /api/favoritos/
